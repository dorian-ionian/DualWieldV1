//-----------------------------------------------------------
// Key bindings for porkmanii's Dual Wielding mutator
//-----------------------------------------------------------
class dw_DualWieldKeyBinding extends GUIUserKeyBinding;

defaultproperties
{
	KeyData(0)=(KeyLabel="Dual Wielding",bIsSection=True)
	KeyData(1)=(Alias="dw_LeftWeaponControl",KeyLabel="Control Left Weapon")
	KeyData(2)=(Alias="dw_RightWeaponControl",KeyLabel="Control Right Weapon")
	KeyData(3)=(Alias="dw_ExtraFireLeft",KeyLabel="Left Alternate Fire")
	KeyData(4)=(Alias="dw_ExtraFireRight",KeyLabel="Right Alternate Fire")
}
